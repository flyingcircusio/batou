#!/bin/sh
{	# prevent execution of partial downloads.
set -e

oops() {
    echo "$0:" "$@" >&2
    exit 1
}

curl -sL https://raw.githubusercontent.com/flyingcircusio/appenv/master/src/appenv.py -o appenv || oops "failed to download appenv"
chmod +x appenv
ln -sf appenv batou
cat >> pyproject.toml <<EOF
[project]
name = "elibrary.batou"
version = "0.1.0"
description = "Migrated Appenv project"
dependencies = [
    "batou",
    "batou_ext",
]
requires-python = ">=3.12,<3.13"
EOF

./appenv update-lockfile
./batou migrate --bootstrap
./batou --help
if [ -d ".git" ]; then
	echo '.appenv' >> .gitignore
	git add .gitignore pyproject.toml uv.lock batou appenv
fi
}
